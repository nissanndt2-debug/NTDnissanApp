{
  "expo": {
    "name": "NissanNDT",
    "slug": "body-app-mobile",
    "scheme": "bodyapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/nissan-ndt-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nissan.bodyapp",
      "infoPlist": {
        "NSCameraUsageDescription": "La camara se usa para escanear el VIN de la unidad y tomar evidencia fotografica de los defectos."
      }
    },
    "android": {
      "package": "com.nissan.bodyapp",
      "icon": "./assets/nissan-ndt-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#0F1620",
        "foregroundImage": "./assets/nissan-ndt-adaptive-foreground.png",
        "monochromeImage": "./assets/nissan-ndt-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/nissan-ndt-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "La camara se usa para escanear el VIN y capturar evidencia de defectos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C3002F"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:3001",
      "router": {},
      "eas": {
        "projectId": "d2a3f70c-cfe0-44f1-88c6-05f17d0fabf3"
      }
    },
    "owner": "danydev7"
  }
}

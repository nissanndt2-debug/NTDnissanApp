PORT=3001
JWT_SECRET=replace_me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
USE_HTTPS=false
NODE_ENV=development

# Fotos de evidencia (Cloudinary). Sin esto, POST /uploads/photo responde
# 501 de forma explicita en vez de fallar a medias.
# Cloudinary Dashboard -> "API Environment variable" (formato
# cloudinary://<api_key>:<api_secret>@<cloud_name>).
CLOUDINARY_URL=
CLOUDINARY_FOLDER=defect-photos

# Legacy: fotos subidas antes de migrar a Cloudinary. Solo se usa para poder
# seguir BORRANDO esas fotos viejas; no subas nada nuevo aqui.
BLOB_PUBLIC_BASE_URL=https://l7ixgbd9kjvd7tod.public.blob.vercel-storage.com
BLOB_READ_WRITE_TOKEN=
